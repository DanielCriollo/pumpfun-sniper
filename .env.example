# ============================================================
#  PUMPFUN SNIPER BOT — Variables de Entorno
#  Copia este archivo como .env y rellena todos los valores.
#  NUNCA subas .env a Git. El .gitignore ya lo excluye.
# ============================================================

# -----------------------------------------------------------
# SOLANA — Conexión RPC
# -----------------------------------------------------------
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY
WS_PUMPFUN_ENDPOINT=wss://pumpportal.fun/api/data
PUMPFUN_API_URL=https://pumpportal.fun/api/trade-local

# -----------------------------------------------------------
# WALLET — Clave Privada
# -----------------------------------------------------------
# ⚠️  NUNCA la compartas ni la subas a ningún repositorio
PRIVATE_KEY=TU_CLAVE_PRIVADA_BASE58

# -----------------------------------------------------------
# PARÁMETROS DE TRADING
# -----------------------------------------------------------
BUY_AMOUNT_SOL=0.05
SLIPPAGE_PERCENT=10
PRIORITY_FEE_SOL=0.001

# -----------------------------------------------------------
# FILTROS ANTI-RUG
# -----------------------------------------------------------
MAX_DEV_BUY_PERCENT=6
MIN_DEV_SOL_AMOUNT=0.000001
MAX_DEV_SOL_AMOUNT=10
REQUIRE_SOCIAL_LINKS=true
METADATA_TIMEOUT_MS=3000
PUMP_TOTAL_SUPPLY=1000000000

# -----------------------------------------------------------
# TAKE PROFIT — basado en % de ganancia desde la entrada
# -----------------------------------------------------------
# TP1: vender cuando el precio suba este % desde la entrada
# Ejemplo: 50 = +50% de ganancia (equivale a 1.5x el mcap de entrada)
TP1_PERCENT=50
# % del balance inicial a vender en TP1
TP1_SELL_PERCENT=50

# TP2: vender cuando el precio suba este % desde la entrada
# Ejemplo: 100 = +100% de ganancia (equivale a 2x el mcap de entrada)
TP2_PERCENT=100
# % adicional del balance inicial a vender en TP2
TP2_SELL_PERCENT=25

# -----------------------------------------------------------
# STOP LOSS — fijo inicial
# -----------------------------------------------------------
# Vender todo si el MC cae este % desde la entrada (ej. 15 = -15%)
SL_PERCENT=15

# -----------------------------------------------------------
# TRAILING STOP LOSS — SL dinámico que asegura ganancias
# -----------------------------------------------------------
# Al superar este % de ganancia, el SL sube a breakeven (precio de entrada)
# → ya no puedes perder dinero en esa posición
TRAILING_SL_BREAKEVEN_PERCENT=30

# Al superar este % de ganancia, se activa el trailing SL
# → el SL empieza a seguir el máximo histórico (HWM)
TRAILING_SL_ACTIVATE_PERCENT=60

# Distancia del trailing SL desde el máximo histórico
# Ejemplo: 15 → SL = HWM - 15%
# Si el token llega a 3x y luego cae 15% desde ese máximo, se vende
TRAILING_SL_DISTANCE_PERCENT=15

# -----------------------------------------------------------
# SALIDA POR TIEMPO — posiciones zombie
# -----------------------------------------------------------
# Si la posición lleva más de estos minutos sin cerrar, se vende automáticamente
MAX_POSITION_HOLD_TIME_MINUTES=15

# -----------------------------------------------------------
# LÍMITES
# -----------------------------------------------------------
MAX_CONCURRENT_POSITIONS=5

# -----------------------------------------------------------
# API INTERNA — Servidor de control
# -----------------------------------------------------------
API_PORT=3000
# Genera con: openssl rand -hex 32
API_SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# N8N — Webhooks de notificación
# -----------------------------------------------------------
N8N_WEBHOOK_URL=http://IP_VPS2:5678/webhook/pumpfun-events
# Genera con: openssl rand -hex 32
N8N_WEBHOOK_SECRET=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# WEBSOCKET — Reconexión
# -----------------------------------------------------------
WS_RECONNECT_DELAY_MS=5000
WS_MAX_RECONNECT_ATTEMPTS=20

# -----------------------------------------------------------
# LOGS
# -----------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production

# ============================================================
#  PUMPFUN SNIPER BOT — Variables de Entorno
#  Copia este archivo como .env y rellena todos los valores.
#  NUNCA subas .env a Git. El .gitignore ya lo excluye.
# ============================================================

# -----------------------------------------------------------
# SOLANA — Conexión RPC
# -----------------------------------------------------------
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY
WS_PUMPFUN_ENDPOINT=wss://pumpportal.fun/api/data
PUMPFUN_API_URL=https://pumpportal.fun/api/trade-local

# -----------------------------------------------------------
# WALLET — Clave Privada
# -----------------------------------------------------------
# ⚠️  NUNCA la compartas ni la subas a ningún repositorio
PRIVATE_KEY=TU_CLAVE_PRIVADA_BASE58

# -----------------------------------------------------------
# PARÁMETROS DE TRADING
# -----------------------------------------------------------
BUY_AMOUNT_SOL=0.05        # Usado cuando DYNAMIC_BUY_PERCENT=0
SLIPPAGE_PERCENT=10
PRIORITY_FEE_SOL=0.001

# -----------------------------------------------------------
# POSITION SIZING DINÁMICO (interés compuesto)
# -----------------------------------------------------------
# Si > 0, compra este % del SOL libre en cada operación.
# Ejemplo: 15 = usar el 15% del balance disponible por compra.
# Poner 0 para usar BUY_AMOUNT_SOL fijo.
DYNAMIC_BUY_PERCENT=15

# -----------------------------------------------------------
# FILTROS ANTI-RUG
# -----------------------------------------------------------
MAX_DEV_BUY_PERCENT=6
MIN_DEV_SOL_AMOUNT=0.000001
MAX_DEV_SOL_AMOUNT=10
# Exige handle real en Twitter/X y Telegram (no URLs genéricas)
REQUIRE_SOCIAL_LINKS=true
METADATA_TIMEOUT_MS=3000
PUMP_TOTAL_SUPPLY=1000000000

# -----------------------------------------------------------
# TAKE PROFIT — % de ganancia sobre la entrada
# -----------------------------------------------------------
TP1_PERCENT=50             # +50% de ganancia (1.5x mcap)
TP1_SELL_PERCENT=50        # Vender 50% del balance inicial
TP2_PERCENT=100            # +100% de ganancia (2x mcap)
TP2_SELL_PERCENT=25        # Vender 25% adicional del balance inicial

# -----------------------------------------------------------
# STOP LOSS fijo inicial
# -----------------------------------------------------------
SL_PERCENT=15              # -15% desde entrada

# -----------------------------------------------------------
# TRAILING STOP LOSS
# -----------------------------------------------------------
TRAILING_SL_BREAKEVEN_PERCENT=30   # Al +30%, SL sube a breakeven
TRAILING_SL_ACTIVATE_PERCENT=60    # Al +60%, activa trailing
TRAILING_SL_DISTANCE_PERCENT=15    # Trailing = HWM - 15%

# -----------------------------------------------------------
# SALIDA POR TIEMPO (posiciones zombie)
# -----------------------------------------------------------
MAX_HOLD_MINUTES=15        # Cierre forzado si la posición dura más de X minutos

# -----------------------------------------------------------
# LÍMITES
# -----------------------------------------------------------
MAX_CONCURRENT_POSITIONS=5

# Market cap máximo al entrar (en SOL). 0 = sin límite.
# Tokens con mcap inicial alto ya tienen menos potencial de subida.
MAX_ENTRY_MCAP_SOL=60

# SOL mínimo que el bot siempre conserva en el wallet (fees + buffer)
MIN_SOL_RESERVE=0.02

# -----------------------------------------------------------
# API INTERNA
# -----------------------------------------------------------
API_PORT=3000
API_SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# N8N — Webhooks
# -----------------------------------------------------------
N8N_WEBHOOK_URL=http://IP_VPS2:5678/webhook/pumpfun-events
N8N_WEBHOOK_SECRET=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# WEBSOCKET
# -----------------------------------------------------------
WS_RECONNECT_DELAY_MS=5000
WS_MAX_RECONNECT_ATTEMPTS=20

# -----------------------------------------------------------
# LOGS
# -----------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production

# ============================================================
#  PUMPFUN SNIPER BOT — Variables de Entorno
#  Copia este archivo como .env y rellena todos los valores.
#  NUNCA subas .env a Git. El .gitignore ya lo excluye.
# ============================================================

# -----------------------------------------------------------
# SOLANA — Conexión RPC
# -----------------------------------------------------------
# Endpoint HTTP de tu RPC premium (Helius, QuickNode, Triton…)
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=TU_API_KEY

# WebSocket de PumpPortal para eventos en tiempo real
WS_PUMPFUN_ENDPOINT=wss://pumpportal.fun/api/data

# URL de la API REST de PumpPortal para construir transacciones
PUMPFUN_API_URL=https://pumpportal.fun/api/trade-local

# -----------------------------------------------------------
# WALLET — Clave Privada
# -----------------------------------------------------------
# Clave privada en Base58 (exportada de Phantom/CLI solana-keygen)
# ⚠️  NUNCA la compartas ni la subas a ningún repositorio
PRIVATE_KEY=TU_CLAVE_PRIVADA_BASE58

# -----------------------------------------------------------
# PARÁMETROS DE TRADING
# -----------------------------------------------------------
# SOL a invertir por cada compra
BUY_AMOUNT_SOL=0.05

# Slippage en porcentaje (10 = 10%)
SLIPPAGE_PERCENT=10

# Priority fee en SOL para acelerar la transacción
PRIORITY_FEE_SOL=0.001

# -----------------------------------------------------------
# FILTROS ANTI-RUG
# -----------------------------------------------------------
# Porcentaje máximo del supply que puede haber comprado el dev (0-100)
MAX_DEV_BUY_PERCENT=6

# SOL mínimo y máximo que puede haber gastado el dev en el bloque de creación
MIN_DEV_SOL_AMOUNT=0.000001
MAX_DEV_SOL_AMOUNT=10

# Exigir que el token tenga al menos un link social en sus metadatos (true/false)
REQUIRE_SOCIAL_LINKS=true

# Timeout en ms para fetchear el URI de metadatos
METADATA_TIMEOUT_MS=3000

# Supply total del token Pump.fun (constante: 1 billón)
PUMP_TOTAL_SUPPLY=1000000000

# -----------------------------------------------------------
# GESTIÓN DE POSICIONES — Take Profit / Stop Loss
# -----------------------------------------------------------
# TP1: vender % al alcanzar X veces el market cap de entrada
TP1_MULTIPLIER=2.0
TP1_SELL_PERCENT=50

# TP2: vender % adicional al alcanzar X veces el market cap de entrada
TP2_MULTIPLIER=3.0
TP2_SELL_PERCENT=25

# SL: vender todo si el MC cae este % desde la entrada (ej. 15 = -15%)
SL_PERCENT=15

# Máximo de posiciones abiertas simultáneamente
MAX_CONCURRENT_POSITIONS=5

# -----------------------------------------------------------
# API INTERNA — Servidor de control
# -----------------------------------------------------------
API_PORT=3000

# Token secreto para autenticar las peticiones entrantes (genera uno con: openssl rand -hex 32)
API_SECRET_KEY=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# N8N — Webhooks de notificación
# -----------------------------------------------------------
# URL del webhook de n8n en VPS 2 (sustituye la IP por la de tu VPS 2)
N8N_WEBHOOK_URL=http://IP_VPS2:5678/webhook/pumpfun-events

# Token compartido para autenticar los webhooks enviados a n8n
N8N_WEBHOOK_SECRET=CAMBIA_ESTO_openssl_rand_hex_32

# -----------------------------------------------------------
# WEBSOCKET — Reconexión
# -----------------------------------------------------------
WS_RECONNECT_DELAY_MS=5000
WS_MAX_RECONNECT_ATTEMPTS=20

# -----------------------------------------------------------
# LOGS
# -----------------------------------------------------------
# Nivel de log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
NODE_ENV=production
